<mujoco model="b2_z1_mppi_big_box_scene">
  <include file="b2_z1_4dof.xml"/>

  <statistic center="0.75 0 0.6" extent="2.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-125" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="big_box" rgba="0 0.4 1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane"
          material="groundplane" friction="0.8 0.005 0.0001" condim="3"/>
    <body name="box" mocap="true" pos="1.5 0 0">
      <geom name="box" type="box" size="0.6 0.6 0.525"
            material="big_box" condim="3"/>
    </body>
  </worldbody>
</mujoco>
