<mujoco model="b2_z1_mppi_push_box_scene">
  <!-- The simulator directly includes the rollout model so robot/box
       dynamics, joint order, sensors and keyframes cannot drift apart. -->
  <include file="b2_z1_base_push_box.xml"/>

  <statistic center="1 0 0.6" extent="2.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-125" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
  </worldbody>
</mujoco>
