      <geom friction="0.6" margin="0.001" condim="1"/>
      <joint axis="0 1 0" damping="2" armature="0.01" frictionloss="0.2"/>
      <!-- MPPI commands joint positions.  Model the Unitree low-level PD loop
           so ctrl has the same meaning in rollout and in the simulator. -->
      <general forcerange="-23.7 23.7" biastype="affine"
        gainprm="50 0 0 0 0 0 0 0 0 0"
        biasprm="0 -50 -3 0 0 0 0 0 0 0"/>
      <default class="abduction">
        <joint axis="1 0 0" damping="1" range="-1.0472 1.0472"/>
        <general ctrlrange="-1.0472 1.0472"/>
      </default>
      <default class="hip">
        <default class="front_hip">
          <joint range="-1.5708 3.4907"/>
          <general ctrlrange="-1.5708 3.4907"/>
        </default>
        <default class="back_hip">
          <joint range="-0.5236 4.5379"/>
          <general ctrlrange="-0.5236 4.5379"/>
        </default>
      </default>
      <default class="knee">
        <!-- The bundled legacy gait bank reaches -2.83 rad while sitting. -->
        <joint range="-2.83 -0.83776"/>
        <general ctrlrange="-2.83 -0.83776" forcerange="-45.43 45.43"/>
      </default>
      <default class="so_arm_joint">
        <joint frictionloss="0.1" armature="0.1" damping="0.2"/>
        <position kp="50" dampratio="1" forcerange="-3.5 3.5"/>
      </default>
      <default class="so_arm_visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0"
          group="2" material="white"/>
      </default>
      <default class="so_arm_motor_visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0"
          group="2" material="black"/>
      </default>
      <default class="so_arm_collision">
        <geom type="mesh" group="3" material="white"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom size="0.022" pos="-0.002 0 -0.213" priority="1" condim="6"
            friction="0.8 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

